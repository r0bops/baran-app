{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/v2/crates/tauri-cli/schema.json",
  "productName": "VenRescate Coordinación",
  "version": "0.1.0",
  "identifier": "org.venrescate.coordinator-desktop",
  "build": {
    "frontendDist": "../coordinator-web/dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd ../coordinator-web && npm run build",
    "beforeDevCommand": "cd ../coordinator-web && npm run dev"
  },
  "app": {
    "title": "VenRescate · Coordinación de Rescate",
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VenRescate · Coordinación",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:* https://api.venrescate.rescue https://sosvenezuela2026.com https://earthquake.usgs.gov https://demotiles.maplibre.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.tile.openstreetmap.org https://*.maptiler.com; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "msi", "nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "VenRescate Rescue Project",
    "category": "Utility"
  },
  "plugins": {
    "store": {
      "filename": "venrescate-coordinator.bin"
    }
  }
}
